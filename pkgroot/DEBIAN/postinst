#!/bin/sh
set -e

case "$1" in
    configure)
        chmod 0755 /usr/bin/griffin-persona
        chmod 0755 /usr/lib/griffin-persona/helper/griffin-persona-helper
        chmod 0644 /usr/lib/griffin-persona/catalog.json

        mkdir -p /var/lib/griffin-postinstall
        chmod 0755 /var/lib/griffin-postinstall

        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications || true
        fi
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q /usr/share/icons/hicolor || true
        fi
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules 2>/dev/null || true
        fi
        ;;
esac

exit 0
