  "repos": {
    "winehq-staging": {
      "key_url": "https://dl.winehq.org/wine-builds/winehq.key",
      "key_path": "/usr/share/keyrings/winehq-archive.key",
      "list_content_tpl": "deb [signed-by=/usr/share/keyrings/winehq-archive.key] https://dl.winehq.org/wine-builds/ubuntu/ {codename} main",
      "list_path": "/etc/apt/sources.list.d/winehq.sources.list",
      "packages": [
        "winehq-staging"
      ]
    },
    "winehq-stable": {
      "key_url": "https://dl.winehq.org/wine-builds/winehq.key",
      "key_path": "/usr/share/keyrings/winehq-archive.key",
      "list_content_tpl": "deb [signed-by=/usr/share/keyrings/winehq-archive.key] https://dl.winehq.org/wine-builds/ubuntu/ {codename} main",
      "list_path": "/etc/apt/sources.list.d/winehq.sources.list",
      "packages": [
        "winehq-stable"
      ]
    },
    "vscode": {
      "key_url": "https://packages.microsoft.com/keys/microsoft.asc",
      "key_path": "/usr/share/keyrings/microsoft.gpg",
      "list_content_tpl": "deb [arch=amd64,arm64,armhf signed-by=/usr/share/keyrings/microsoft.gpg] https://packages.microsoft.com/repos/code stable main",
      "list_path": "/etc/apt/sources.list.d/vscode.list",
      "packages": [
        "code"
      ],
      "key_is_asc": true
    },
    "docker": {
      "key_url": "https://download.docker.com/linux/ubuntu/gpg",
      "key_path": "/usr/share/keyrings/docker.gpg",
      "list_content_tpl": "deb [arch=amd64 signed-by=/usr/share/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu {codename} stable",
      "list_path": "/etc/apt/sources.list.d/docker.list",
      "packages": [
        "docker-ce",
        "docker-ce-cli",
        "containerd.io"
      ],
      "key_is_asc": true
    },
    "firefox-mozilla": {
      "key_url": "https://packages.mozilla.org/apt/repo-signing-key.gpg",
      "key_path": "/etc/apt/keyrings/packages.mozilla.org.asc",
      "list_content_tpl": "deb [signed-by=/etc/apt/keyrings/packages.mozilla.org.asc] https://packages.mozilla.org/apt mozilla main",
      "list_path": "/etc/apt/sources.list.d/mozilla.list",
      "packages": [
        "firefox"
      ],
      "preference_path": "/etc/apt/preferences.d/mozilla",
      "preference_content": "Package: *\nPin: origin packages.mozilla.org\nPin-Priority: 1000\n"
    },
    "brave-browser": {
      "key_url": "https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg",
      "key_path": "/usr/share/keyrings/brave-browser-archive-keyring.gpg",
      "list_content_tpl": "deb [signed-by=/usr/share/keyrings/brave-browser-archive-keyring.gpg] https://brave-browser-apt-release.s3.brave.com/ stable main",
      "list_path": "/etc/apt/sources.list.d/brave-browser-release.list",
      "packages": [
        "brave-browser"
      ]
    },
    "vivaldi": {
      "key_url": "https://repo.vivaldi.com/archive/linux_signing_key.pub",
      "key_path": "/usr/share/keyrings/vivaldi-archive-keyring.gpg",
      "list_content_tpl": "deb [signed-by=/usr/share/keyrings/vivaldi-archive-keyring.gpg] https://repo.vivaldi.com/archive/deb stable main",
      "list_path": "/etc/apt/sources.list.d/vivaldi.list",
      "packages": [
        "vivaldi-stable"
      ],
      "key_is_asc": true
    }
  },
  "release_apps": {
    "lact": {
      "repo": "ilya-zlobintsev/LACT",
      "asset_re": ".*\\.deb$"
    },
    "sunshine": {
      "repo": "LizardByte/Sunshine",
      "asset_re": "sunshine.*ubuntu.*\\.deb$"
    },
    "opentabletdriver": {
      "repo": "OpenTabletDriver/OpenTabletDriver",
      "asset_re": "opentabletdriver_.*_x64\\.deb$"
    }
  }
